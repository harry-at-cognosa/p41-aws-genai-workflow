# Copy to .env and fill in. .env is gitignored.

# AWS
AWS_REGION=us-west-2

# Bedrock — Claude on Bedrock requires cross-region inference profiles for v4.x models.
# us-prefixed = US-region routing (us-east-1, us-east-2, us-west-2).
# Set to the haiku ID below for cost-mode demos.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# After `cdk deploy`, copy these from stack outputs:
API_BASE_URL=
API_KEY=
